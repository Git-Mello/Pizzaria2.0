classDiagram
    direction TB

    namespace model {
        class Forma {
            <<abstract>>
            +AREA_MINIMA$ double
            +AREA_MAXIMA$ double
            -double dimensao
            +setDimensao(double dimensao)
            +calcularArea()* double
            +getNome() String
            +getNomeDimensao()* String
            +getDimensaoMinima()* double
            +getDimensaoMaxima()* double
            +getTipo()* TipoForma
        }
        class Circulo {
            +calcularArea() double
        }
        class Quadrado {
            +calcularArea() double
        }
        class Triangulo {
            +calcularArea() double
        }
        class TipoForma {
            <<enumeration>>
            CIRCULO
            QUADRADO
            TRIANGULO
            +criar(double dimensao) Forma
            +criarPorArea(double area) Forma
            +calcularDimensao(double area) double
            +getDimensaoMinima() double
            +getDescricaoLimites() String
        }
        class Pizza {
            -long id
            -double preco
            -calcularPreco() double
            +getArea() double
            +getDescricaoSabores() String
        }
        class Sabor {
            -long id
            -String nome
        }
        class TipoPizza {
            +PRECO_MINIMO$ double
            +PRECO_MAXIMO$ double
            -long id
            -String nome
            -double precoCm2
            +setPrecoCm2(double precoCm2)
        }
        class Pedido {
            -long id
            +adicionarPizza(Pizza)
            +removerPizza(int)
            +getPrecoTotal() double
            +podeSerAlterado() boolean
            +podeMudarPara(EstadoPedido) boolean
        }
        class EstadoPedido {
            <<enumeration>>
            ABERTO
            A_CAMINHO
            ENTREGUE
        }
        class Cliente {
            -long id
            -String nome
            -String sobrenome
            -String telefone
            +soNumeros(String texto)$ boolean
        }
    }

    namespace dao {
        class ConnectionFactory {
            -Properties properties
            +getConnection()$ Connection
            -readProperties()$
        }
        class DaoFactory {
            +getClienteDao()$ ClienteDao
            +getSaborDao()$ SaborDao
            +getTipoPizzaDao()$ TipoPizzaDao
            +getPedidoDao()$ PedidoDao
        }
        class ClienteDao {
            <<interface>>
            +add(Cliente)
            +getAll() List~Cliente~
            +getById(long id) Cliente
            +getByFiltro(String sobrenome, String telefone) List~Cliente~
            +update(Cliente)
            +delete(Cliente)
        }
        class SaborDao {
            <<interface>>
            +add(Sabor)
            +getAll() List~Sabor~
            +getById(long id) Sabor
            +update(Sabor)
            +delete(Sabor)
            +isEmUso(Sabor) boolean
        }
        class TipoPizzaDao {
            <<interface>>
            +getAll() List~TipoPizza~
            +getById(long id) TipoPizza
            +update(TipoPizza)
            +update(List~TipoPizza~ tipos)
        }
        class PedidoDao {
            <<interface>>
            +add(Pedido)
            +getAll() List~Pedido~
            +getById(long id) Pedido
            +getByCliente(Cliente) List~Pedido~
            +update(Pedido)
            +updateEstado(Pedido)
            +delete(Pedido)
        }
        class ClienteDaoSql {
            <<Singleton>>
            +getInstance()$ ClienteDaoSql
        }
        class SaborDaoSql {
            <<Singleton>>
            +getInstance()$ SaborDaoSql
        }
        class TipoPizzaDaoSql {
            <<Singleton>>
            +getInstance()$ TipoPizzaDaoSql
        }
        class PedidoDaoSql {
            <<Singleton>>
            +getInstance()$ PedidoDaoSql
        }
    }

    Forma <|-- Circulo
    Forma <|-- Quadrado
    Forma <|-- Triangulo
    TipoForma ..> Forma : cria
    Pizza --> "1" Forma
    Pizza --> "1..2" Sabor
    Sabor --> "1" TipoPizza
    Pedido --> "1" Cliente
    Pedido *-- "1..*" Pizza
    Pedido --> "1" EstadoPedido

    ClienteDao <|.. ClienteDaoSql
    SaborDao <|.. SaborDaoSql
    TipoPizzaDao <|.. TipoPizzaDaoSql
    PedidoDao <|.. PedidoDaoSql
    DaoFactory ..> ClienteDaoSql
    DaoFactory ..> SaborDaoSql
    DaoFactory ..> TipoPizzaDaoSql
    DaoFactory ..> PedidoDaoSql
    ClienteDaoSql ..> ConnectionFactory
    SaborDaoSql ..> ConnectionFactory
    TipoPizzaDaoSql ..> ConnectionFactory
    PedidoDaoSql ..> ConnectionFactory
